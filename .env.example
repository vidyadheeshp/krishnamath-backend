PORT=5000
NODE_ENV=development
# Required in production: random string, 32+ characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://username:password@localhost:5432/temple_db
DB_POOL_MAX=10
# Set to 1 when running behind Nginx or a hosting proxy
TRUST_PROXY=
